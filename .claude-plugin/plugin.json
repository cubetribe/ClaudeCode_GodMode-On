{
  "name": "cc-godmode",
  "displayName": "GodMode Core for Claude Code",
  "version": "9.0.0",
  "description": "GodMode Core for Claude Code (currently CC_GodMode) — self-orchestrating, parallel-first multi-agent development system, orchestrated by Opus 5.5 (`opus`). 14 agents (7 core + 1 security gate + 6 department), Smart Routing default, dynamic-workflows escalation, risk-based quality gates. You say WHAT, the AI decides HOW.",
  "author": {
    "name": "Dennis Westermann",
    "url": "https://www.dennis-westermann.de"
  },
  "homepage": "https://github.com/cubetribe/ClaudeCode_GodMode-On",
  "repository": "https://github.com/cubetribe/ClaudeCode_GodMode-On",
  "license": "LicenseRef-CC-GodMode-Proprietary",
  "keywords": [
    "orchestration",
    "multi-agent",
    "quality-gates",
    "development-workflow",
    "ai-agents",
    "code-quality",
    "automated-testing",
    "self-improving",
    "claude-opus-5-5",
    "godmode-core",
    "ultracode",
    "claude-code",
    "subagents",
    "token-efficiency",
    "dynamic-workflows",
    "parallel-subagents"
  ],
  "agents": [
    "./agents/researcher.md",
    "./agents/architect.md",
    "./agents/api-guardian.md",
    "./agents/builder.md",
    "./agents/tester.md",
    "./agents/scribe.md",
    "./agents/github-manager.md",
    "./agents/security.md",
    "./agents/ci-security-guardian.md",
    "./agents/docs-dx.md",
    "./agents/quality-operations.md",
    "./agents/runtime-platform.md",
    "./agents/workflow-design.md",
    "./agents/workspace-governance.md"
  ],
  "skills": [
    "./skills/sprint-planning",
    "./skills/workflows",
    "./skills/dynamic-workflows",
    "./skills/quality-gates",
    "./skills/release",
    "./skills/issue-processing",
    "./skills/api-change",
    "./skills/research",
    "./skills/meta-decisions",
    "./skills/agent-teams",
    "./skills/prototype-mode",
    "./skills/departments",
    "./skills/cost-efficiency",
    "./skills/greenfield-bootstrap"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/session-start.js",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/check-api-impact.js",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/validate-agent-output.js",
            "timeout": 30
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/validate-agent-output.js",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "optional": true
    }
  }
}
