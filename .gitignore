# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Agent/subagent reports are TRACKED since v8.5.0 (maintainer rule 2026-07-06):
# every agent and subagent writes its markdown report into reports/vX.Y.Z/sprint-NN/
# inside the repo — never into /tmp or session scratch dirs, which vanish on
# session interruption. Reports are committed at sprint integration.

# Legacy Agents folder (for projects using CC_GodMode)
/Agents/*
!/Agents/.gitkeep

# Meta-Orchestration Design Work (experimental - separate repos)
/Orchester-Design/

# Agent definitions must be tracked (these are the agent prompts, not reports)
!agents/*.md

# Node
node_modules/

# Logs
*.log
npm-debug.log*

# Temporary
*.tmp
*.temp

# Secrets (should never be here anyway)
.env
.env.*
*.pem
*.key
credentials.json
.playwright-mcp/
